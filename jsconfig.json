{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "index.js",
    "host/**/*.js",
    "src/**/*.js",
    "build.mjs",
    "bench/**/*.mjs"
  ],
  "exclude": ["node_modules", "client.js", "test"]
}
